# PROCUREX — Environment Variables
# SIH26100 · AI-Powered Bid Compliance Verification Platform
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# When true: mock government APIs, synthetic data labels, demo scenarios available
ENABLE_DEMO_MODE=true
DEMO_SEED=42

# ── Security ───────────────────────────────────────────────────────────────────
# CHANGE THIS in production — use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-STRONG-RANDOM-KEY-MIN-32-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=procurex
DATABASE_URL=postgresql+asyncpg://procurex:procurex@localhost:5432/procurex

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Object Storage (MinIO / S3-compatible) ─────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=procurex
MINIO_SECRET_KEY=procurex123
MINIO_BUCKET_DOCUMENTS=procurex-documents
MINIO_BUCKET_DEMO=procurex-demo
MINIO_SECURE=false

# ── AI Provider ────────────────────────────────────────────────────────────────
# "mock" = no AI calls (demo mode extraction uses mock responses)
# "gemini" = Google Gemini API
# "openai" = OpenAI-compatible API (also supports Ollama, Together, etc.)
# "ollama" = Local Ollama instance
AI_PROVIDER=mock

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint.com/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Embedding ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=sentence_transformers
VECTOR_DIMENSION=384

# ── Document Processing ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES_PER_DOCUMENT=500
OCR_CONFIDENCE_THRESHOLD=0.7
OCR_ENGINE=pymupdf
ENABLE_MALWARE_SCAN=false
# MALWARE_SCAN_ENDPOINT=http://clamav:3310

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── CORS ───────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# ── Demo User Credentials (CHANGE IMMEDIATELY IN PRODUCTION) ──────────────────
ADMIN_EMAIL=admin@procurex.local
ADMIN_PASSWORD=Admin@123!Demo
OFFICER_EMAIL=officer@procurex.local
OFFICER_PASSWORD=Officer@123!Demo
ANALYST_EMAIL=analyst@procurex.local
ANALYST_PASSWORD=Analyst@123!Demo
AUDITOR_EMAIL=auditor@procurex.local
AUDITOR_PASSWORD=Auditor@123!Demo

# ── Government API Credentials (NOT AVAILABLE WITHOUT AUTHORIZATION) ───────────
# These require official authorization from respective government departments.
# Leave empty to use mock/sandbox adapters (clearly labeled in UI).
# Real adapters replace mock adapters when credentials are provided.
GST_API_KEY=
GST_API_URL=
MCA_API_KEY=
MCA_API_URL=
UDYAM_API_KEY=
UDYAM_API_URL=
PAN_API_KEY=
PAN_API_URL=
EPFO_API_KEY=
ESIC_API_KEY=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
GEM_API_KEY=
BIS_API_KEY=
